from flask import Flask, jsonify, request

book_fetcher = Flask(__name__)

books = [
    {"id": 101, "title": "Deep Work", "author": "Cal Newport"}
]
next_id = 102


@book_fetcher.route('/books', methods=['GET'])
def get_books():
    return jsonify(books), 200


@book_fetcher.route('/books/count', methods=['GET'])
def get_book_count():
    return jsonify({"count": len(books)}), 200


@book_fetcher.route('/books/<int:book_id>', methods=['GET'])
def get_book(book_id):
    book = next((b for b in books if b["id"] == book_id), None)
    if book is None:
        return jsonify({"error": f"Book with id {book_id} not found"}), 404
    return jsonify(book), 200


@book_fetcher.route('/books', methods=['POST'])
def create_book():
    global next_id
    data = request.get_json()

    if not data or 'title' not in data or 'author' not in data:
        return jsonify({"error": "Both 'title' and 'author' are required"}), 400

    new_book = {
        "id": next_id,
        "title": data['title'],
        "author": data['author']
    }
    books.append(new_book)
    next_id += 1

    return jsonify(new_book), 201


@book_fetcher.route('/books/<int:book_id>', methods=['PUT'])
def update_book(book_id):
    book = next((b for b in books if b["id"] == book_id), None)
    if book is None:
        return jsonify({"error": f"Book with id {book_id} not found"}), 404

    data = request.get_json()
    if not data:
        return jsonify({"error": "Request body must be JSON"}), 400

    if 'title' in data:
        book['title'] = data['title']
    if 'author' in data:
        book['author'] = data['author']

    return jsonify(book), 200


@book_fetcher.route('/books/<int:book_id>', methods=['DELETE'])
def delete_book(book_id):
    global books
    book = next((b for b in books if b["id"] == book_id), None)
    if book is None:
        return jsonify({"error": f"Book with id {book_id} not found"}), 404

    books = [b for b in books if b["id"] != book_id]
    return jsonify({"message": f"Book with id {book_id} deleted"}), 200


if __name__ == '__main__':
    book_fetcher.run(debug=True, port=5000)

